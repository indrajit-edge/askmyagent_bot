# ==============================================================================
# AskMyAgent — Backend & Telegram Bot Environment Configuration Template
# ==============================================================================

# Server & Network
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://askmyagent.com
CORS_ORIGIN=https://askmyagent.com
DATABASE_URL=
DB_SSL=true
DATABASE_PATH=backend/database.sqlite

# Admin Control Center Authentication
ADMIN_USERNAME=
# Prefer ADMIN_PASSWORD_HASH generated with bcrypt. Use ADMIN_PASSWORD only for local development.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Comma-separated public IP addresses allowed to access the Admin
# Control Center and administrative APIs.
#
# Production MUST be configured.
# If missing in production, admin access fails closed.
#
# Never expose this through VITE_* variables.
ADMIN_ALLOWED_IPS=203.0.113.1

# Cryptography & Security Secrets
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://api.askmyagent.com/api/bot/webhook
TELEGRAM_WEBHOOK_SECRET=

# Google Cloud OAuth 2.0 Credentials (Web Application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.askmyagent.com/api/oauth/callback

# Optional
GEMINI_API_KEY=
COOKIE_DOMAIN=
